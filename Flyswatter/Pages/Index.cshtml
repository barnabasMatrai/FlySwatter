@page
@model IndexModel
@{
    ViewData["Title"] = GameConfiguration.Title;
    ViewData["Edition"] = GameConfiguration.Edition;
}

<div class="max-height">
    <div class="playing-field" class="max-height">
        <div class="title-screen max-height">
            <center>
                <img class="responsive-image" src="Resources/@{
                    @ViewData["Edition"]
}-edition/title1.png" />
            </center>

            <div id="bugs-div">
                <div id="border-top-left-bottom" class="bug-and-point">
                    <div class="big-bug">
                        <img class="img-as-big-as-div" src="Resources/@{
                            @ViewData["Edition"]
}-edition/targetNormal.png" />
                    </div>
                    <div class="point-text">
                        <p>+3 pont</p>
                    </div>
                </div>
                <div id="border-top-bottom" class="bug-and-point">
                    <div class="big-bug">
                        <img class="img-as-big-as-div" src="Resources/@{
@ViewData["Edition"]
}-edition/targetAvoid.png" />
                    </div>
                    <div class="point-text">
                        <p>-3 pont</p>
                    </div>
                </div>
                <div id="border-top-right-bottom" class="bug-and-point">
                    <div class="big-bug">
                        <img class="img-as-big-as-div" src="Resources/@{
                            @ViewData["Edition"]
}-edition/targetExtra.png" />
                    </div>
                    <div class="point-text">
                        <p>+10 pont</p>
                    </div>
                </div>
            </div>
            <center>
                <div id="start-button-div">
                    <a id="start-button" asp-area="" asp-page="/Game">Kezdés</a>
                </div>
            </center>
        </div>
    </div>
</div>

<script src="~/js/game.js" asp-append-version="true"></script>