@page
@model Flyswatter.Pages.GameModel
@{
    ViewData["Title"] = GameConfiguration.Title;
    ViewData["Edition"] = GameConfiguration.Edition;
}

<img id="flyImg" class="fly-image" src="Resources/@{
                        @ViewData["Edition"]
}-edition/targetNormal.png" onclick="increaseScore(this, 3)" hidden />
<img id="ladybugImg" class="fly-image" src="Resources/@{
                        @ViewData["Edition"]
}-edition/targetAvoid.png" onclick="increaseScore(this, -3)" hidden />
<img id="goldenFlyImg" class="fly-image" src="Resources/@{
                        @ViewData["Edition"]
}-edition/targetExtra.png" onclick="increaseScore(this, 10)" hidden />
<div class="stats">
    <span id="score">Pontszám: 0</span>
    <span id="timer">60</span>
</div>
<div id="field">
    <div id="result-screen" hidden>
        <p class="five-size">Eredmény</p>
        <p id="result-screen-points" />
        <div>
            <a href="javascript:void(0)" class="button" onclick="startGame()">Újrakezdés</a>
            <a class="button" asp-area="" asp-page="/Index">Vissza a főoldalra</a>
        </div>
    </div>
</div>
<script src="~/js/game.js" asp-append-version="true"></script>
